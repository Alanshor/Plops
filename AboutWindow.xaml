<Window x:Class="Happy_Plops.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Happy_Plops"
        mc:Ignorable="d"
        Title="Über" Height="250" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Logo (optional) -->
            <Image Source="/logo.png" Width="64" Height="64" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock x:Name="GameTitle" Text="GameTitle" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Text="Version: ..." />
                <TextBlock x:Name="AutorText" Text="von Alan Shor" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,10"
                   Text="Am Anfang war ein Plop. Dann plopten die Gruppen dazu. Es nahm blind seinen Lauf und niemand wusste, wohin der Weg führte. 
                   Wenn Sie diese Zeilen auf Ihrem Bildschirm lesen können, könnte es sein, das die Richtung entschieden und das Vergnügen, zumindest für eine Seite, vorbereitet ist."/>

        <Button Grid.Row="2" Content="Danke für die Info!" Width="200" HorizontalAlignment="Right" Click="OkButton_Click" IsCancel="True"/>
    </Grid>
</Window>
